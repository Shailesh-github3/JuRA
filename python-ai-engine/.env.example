# ---------------------------------------------------------------------------
# JuRA Python AI engine -- template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored; this template is safe to commit.
# ---------------------------------------------------------------------------

# --- Qdrant vector store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=jura_legal_chunks

# --- Embeddings ---
# Ingestion and querying MUST use the same model + dimension, or similarity
# search breaks silently (vectors from two models are not comparable).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_TOKENS=256

# --- Chunking ---
MAX_CHUNK_CHARS=1500

# --- Retrieval ---
# Minimum cosine similarity for a chunk to count as relevant. Below this,
# retrieval returns nothing and /query refuses instead of answering from
# unrelated law. Raise it to be stricter, lower it to be more permissive.
# Tune it with: python scripts/evaluate_retrieval.py
MIN_SIMILARITY_SCORE=0.35

# --- Hybrid retrieval ---
# Fuse BM25 lexical search with dense Qdrant search via RRF. Fixes exact
# section-number lookups (e.g. "Article 14", "Section 103 BNS") where dense
# embeddings confuse numerals. Set to false for dense-only ablation.
HYBRID_SEARCH_ENABLED=true
RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=4

# --- Cross-encoder reranker ---
# Re-score RRF candidates with BAAI/bge-reranker-base. Adds ~15x latency.
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_CANDIDATE_K=15

# --- Fact extraction & clarification loop (Feature 4) ---
CLARIFICATION_ENABLED=true
MAX_CLARIFICATION_TURNS=1

# --- LLM (app/rag/rag_service.py) ---
# Required for POST /query to answer. Without it the endpoint returns 503
# ("GOOGLE_API_KEY is not configured") instead of calling the model.
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
